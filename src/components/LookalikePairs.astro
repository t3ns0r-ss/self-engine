---
// Look-alike pairs (PLAN.md Section 6.11): two similar problems that need different tools.
import { loadData, problemsOf, PLATFORM_NAMES } from '../lib/data';
import { cardLabel } from '../lib/cards';
const { topic } = Astro.props as { topic: string };
const data = await loadData();
const tf = data.topics[topic];
// A tool is a {topic, card} reference (rendered as the card's name with a link) or, in older topics, free text.
const tool = (t: string | { topic: string; card: string }) => (typeof t === 'string' ? { name: t, topic: null, href: null } : cardLabel(data, t));
const byId = new Map(problemsOf(data, topic, ['lookalike']).map((p) => [p.id, p]));
---
{(tf?.lookalike_pairs ?? []).map((pair, i) => {
  const a = byId.get(pair.a)!;
  const b = byId.get(pair.b)!;
  return (
    <section class="lookalike-pair">
      <h3>Pair {i + 1}</h3>
      <div class="pair-grid">
        {[a, b].map((p, k) => (
          <div>
            <p><strong>{k === 0 ? 'A' : 'B'}:</strong> <a href={p.url} target="_blank" rel="noopener noreferrer">{p.title}</a> <span class={`badge badge-${p.source}`}>{PLATFORM_NAMES[p.source]}</span> {p.difficulty}</p>
            <p>{p.summary}</p>
          </div>
        ))}
      </div>
      <details>
        <summary>Which tool for each, and why?</summary>
        {[['A', pair.a_tool], ['B', pair.b_tool]].map(([k, t]) => {
          const l = tool(t as string | { topic: string; card: string });
          return <p><strong>{k}:</strong> {l.href ? <a href={l.href}>{l.name}</a> : l.name}{l.topic && ` (topic ${l.topic})`}.</p>;
        })}
        {pair.shared_surface && <p><strong>What makes them look alike:</strong> {pair.shared_surface}</p>}
        <p><strong>The difference that flips the choice:</strong> {pair.flipping_difference}</p>
        {pair.flipping_input && <p><strong>Where the two tools disagree:</strong> {pair.flipping_input}</p>}
      </details>
    </section>
  );
})}
