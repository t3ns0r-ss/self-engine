---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import BankOverview, { type OverviewRow } from '../../components/BankOverview';
import { loadData, practiceOf, topicSlug } from '../../lib/data';

const { curriculum, banks } = await loadData();
const rows: OverviewRow[] = curriculum
  .filter((t) => t.id !== '7.8')
  .map((t) => {
    const practice = practiceOf(banks[t.id]);
    const tiers = [1, 2, 3, 4, 5].map((k) => practice.filter((p) => p.tier === k).length);
    return {
      id: t.id,
      title: t.title,
      phase: t.phase,
      href: `/bank/${topicSlug(t.id)}/`,
      tiers,
      practiceIds: practice.map((p) => p.id),
      status: banks[t.id] ? banks[t.id].status.replace('_', ' ') : 'not started',
    };
  });
---
<StarlightPage frontmatter={{ title: 'Problem bank', description: 'Practice problems for every topic, by difficulty tier.' }}>
  <p>
    Every topic's practice problems, sorted into five difficulty tiers relative to the phase's target rating:
    <strong>1 Warm-up</strong>, <strong>2 Easy</strong>, <strong>3 Core</strong>, <strong>4 Hard</strong>, <strong>5 Stretch</strong>.
    You can practise any topic whose bank is ready, even before its lesson is written. Solve problems on the platform itself,
    then log the result here.
  </p>
  <p>
    Some problems are held back on purpose for drills, checkpoints, reviews, and exams. They appear only inside lessons,
    because a problem you have already seen tests memory, not recognition.
  </p>
  <BankOverview client:load rows={rows} />
</StarlightPage>
