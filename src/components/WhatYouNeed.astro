---
// "What you need" list of a lesson (PLAN.md Section 10.9), rendered from the same `uses` list as the
// "Builds on" line in TopicHeader, so the two cannot disagree. Usage in MDX: <WhatYouNeed topic="1.3" />
import { loadData, getUses } from '../lib/data';
const { topic } = Astro.props as { topic: string };
const data = await loadData();
const uses = getUses(data, topic);
---
<ul>
  {uses.map((u) => (
    <li>
      {u.href ? <a href={u.href}>Topic {u.topic}, {u.title}</a> : <span>Topic {u.topic}, {u.title} <em>(coming soon)</em></span>}: {u.what}
    </li>
  ))}
</ul>
