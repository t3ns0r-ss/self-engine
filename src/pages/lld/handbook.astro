---
// Pattern Handbook (DESIGN_TRACKS_PLAN.md Section 11.5): built from every LLD topic file's cards and decision map.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DesignHandbook, { type HCard, type HGroup } from '../../components/design/DesignHandbook';
import { loadData, designLessonHref } from '../../lib/data';
const track = 'lld' as const;
const data = await loadData();
const rows = data.designCurriculum.filter((t) => t.track === track);
const cards: HCard[] = rows.flatMap((t) => (data.designTopics[t.id]?.cards ?? []).map((c) => ({
  topic: t.id, order: t.order, id: c.id, name: c.name, property: c.decisive_property, test: c.how_to_test, cost: c.cost,
  href: data.lessons[t.id] ? `${designLessonHref(t)}#card-${c.id}` : null, holds: c.lab?.holds_test, breaks: c.lab?.breaks_test,
})));
const nameOf = (id: string) => cards.find((c) => c.id === id)?.name ?? id;
const groups: HGroup[] = rows.flatMap((t) => (data.designTopics[t.id]?.decision_map ?? []).map((e) => ({
  signal: e.weak_signal, choose: e.choose, chooseName: nameOf(e.choose), when: e.when, topic: t.id, order: t.order, over: e.over.map((o) => `${nameOf(o.card)} (${o.because})`),
})));
---
<StarlightPage frontmatter={{ title: 'Pattern Handbook' }}>
  <DesignHandbook client:load track={track} topics={rows.map((t) => ({ id: t.id, order: t.order, title: t.title }))} cards={cards} groups={groups} />
</StarlightPage>
