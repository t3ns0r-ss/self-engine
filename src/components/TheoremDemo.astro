---
// A theorem's demo (PLAN.md Section 8.6): the unit's solution.cpp and its tested expected output.
// Usage in MDX: <TheoremDemo unit="1.6/thm-1" />
import { Code } from '@astrojs/starlight/components';
const { unit } = Astro.props as { unit: string };
const files = import.meta.glob('/code/**/{solution.cpp,tests/1.out}', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const source = files[`/code/${unit}/solution.cpp`];
const output = files[`/code/${unit}/tests/1.out`];
if (source === undefined || output === undefined) throw new Error(`TheoremDemo: unit ${unit} not found`);
---
<div class="theorem-demo">
  <p><strong>Demo:</strong> this program runs the theorem on the tiny instance above.</p>
  <Code code={source.trimEnd()} lang="cpp" />
  <p><strong>Output</strong></p>
  <Code code={output.trimEnd()} lang="text" />
</div>
