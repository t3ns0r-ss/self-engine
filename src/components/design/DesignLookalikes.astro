---
// Look-alike pairs (Section 8.11). Both sides are named by card or by plain words; HLD pairs cite a lab test for each side where possible.
import { loadData, designRow, designLessonHref } from '../../lib/data';
const { topic } = Astro.props as { topic: string };
const data = await loadData();
const pairs = data.designTopics[topic]?.lookalike_pairs ?? [];
const tool = (t: string | { topic: string; card: string }) => {
  if (typeof t === 'string') return { name: t, href: null as string | null };
  const c = data.designTopics[t.topic]?.cards.find((x) => x.id === t.card);
  return { name: c?.name ?? t.card, href: data.lessons[t.topic] ? `${designLessonHref(designRow(data, t.topic))}#card-${t.card}` : null };
};
---
{pairs.map((p, i) => (
  <section class="lookalike-pair">
    <h3>Pair {i + 1}</h3>
    <div class="pair-grid"><div><p><strong>A:</strong> {p.a}</p></div><div><p><strong>B:</strong> {p.b}</p></div></div>
    <details>
      <summary>Which structure for each, and why?</summary>
      {[['A', p.a_tool], ['B', p.b_tool]].map(([k, t]) => { const l = tool(t as string | { topic: string; card: string }); return <p><strong>{k}:</strong> {l.href ? <a href={l.href}>{l.name}</a> : l.name}.</p>; })}
      <p><strong>The difference that flips the choice:</strong> {p.flipping_difference}</p>
      {p.flipping_input && <p><strong>Where the two disagree:</strong> {p.flipping_input}</p>}
    </details>
  </section>
))}
