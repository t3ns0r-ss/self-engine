---
// Recognition Cards (PLAN.md Section 6.5), rendered from the topic data file.
import { loadData } from '../lib/data';
const { topic } = Astro.props as { topic: string };
const data = await loadData();
const cards = data.topics[topic]?.cards ?? [];
---
{cards.map((c) => (
  <section class="recognition-card" id={`card-${c.id}`}>
    <h3>{c.name}</h3>
    <p><strong>Decisive property</strong> ({c.from_theorem}): {c.decisive_property}</p>
    <p><strong>How to test it:</strong> {c.how_to_test}</p>
    <p><strong>Weak signals</strong> (suggest the card, prove nothing):</p>
    <ul>{c.weak_signals.map((s) => <li>{s}</li>)}</ul>
    <p><strong>Kill signals</strong> (rule the card out):</p>
    <ul>{c.kill_signals.map((s) => <li>{s}</li>)}</ul>
    {c.lookalikes.length > 0 && (
      <>
        <p><strong>Look-alikes:</strong></p>
        <ul>{c.lookalikes.map((l) => <li>{l.description}. Needs {l.needs}. Difference: {l.flipping_difference}</li>)}</ul>
      </>
    )}
    <p><strong>Complexity:</strong> {c.complexity}</p>
  </section>
))}
