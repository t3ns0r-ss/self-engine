---
// Decision map entries added by this topic (PLAN.md Section 6.14).
import { loadData } from '../lib/data';
import { cardName } from '../lib/cards';
import { url } from '../lib/url';
const { topic } = Astro.props as { topic: string };
const data = await loadData();
const entries = data.topics[topic]?.decision_map ?? [];
---
<div class="table-scroll">
  <table>
    <thead><tr><th>When you see</th><th>Choose</th><th>If</th><th>Instead of</th></tr></thead>
    <tbody>
      {entries.map((e) => (
        <tr>
          <td>{e.weak_signal}</td>
          <td>{cardName(data, e.choose, topic)}</td>
          <td>{e.when}</td>
          <td>{e.over.length ? <ul>{e.over.map((o) => <li><strong>{cardName(data, o.card, o.topic)}</strong>: {o.because}</li>)}</ul> : '—'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p><a href={url('/handbook/')}>See the whole Recognition Handbook</a></p>
