---
// Home dashboard (PLAN.md Section 10.1). Usage in MDX: <Dashboard />
import { loadData, problemIndex, practiceOf, lessonHref, topicSlug } from '../lib/data';
import { url } from '../lib/url';
import DashboardIsland, { type DashTopic, type DashProblem } from './DashboardIsland';

const data = await loadData();
const topics: DashTopic[] = data.curriculum.map((t) => {
  const tf = data.topics[t.id];
  const ladder = tf
    ? tf.problems.filter((p) => p.role === 'ladder')
        .sort((a, b) => tf.cards.findIndex((c) => c.id === a.card) - tf.cards.findIndex((c) => c.id === b.card) || a.rung! - b.rung!)
        .map((p) => ({ id: p.id, label: `rung ${p.rung} of ${tf.cards.find((c) => c.id === p.card)!.name}` }))
    : practiceOf(data.banks[t.id]).map((p) => ({ id: p.id, label: p.title }));
  const reviews = tf ? ([1, 2, 3] as const).map((s) => tf.problems.filter((p) => p.role === 'review' && p.review_set === s).map((p) => p.id)) : [[], [], []];
  return {
    id: t.id, order: t.order, title: t.title,
    href: data.lessons[t.id] ? lessonHref(t) : url(`/bank/${topicSlug(t.id)}/`),
    hasLesson: !!data.lessons[t.id], hasCheckpoint: !!tf, ladder, reviews,
  };
});
const problems: Record<string, DashProblem> = Object.fromEntries(
  problemIndex(data).map((p) => [p.id, { title: p.title, url: p.url, topic: p.topic, card: p.cardName }]),
);
---
<DashboardIsland client:load topics={topics} problems={problems} />
