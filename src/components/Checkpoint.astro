---
// Checkpoint (PLAN.md Sections 6.13 and 10.4). Usage in MDX: <Checkpoint topic="1.3" />
import { loadData, problemsOf } from '../lib/data';
import CheckpointIsland, { type CheckpointProblem } from './CheckpointIsland';

const { topic } = Astro.props as { topic: string };
const data = await loadData();
const tf = data.topics[topic];
const byId = new Map(problemsOf(data, topic, ['checkpoint']).map((p) => [p.id, p]));
const problems: CheckpointProblem[] = (tf?.checkpoint.problems ?? []).map((id) => {
  const p = byId.get(id)!;
  return { id, title: p.title, url: p.url, source: p.source, difficulty: p.difficulty };
});
const drill = (tf?.drill ?? []).map((d) => ({ problem: d.problem, answer: `${d.answer_topic}:${d.answer_card}` }));
---
<CheckpointIsland client:load topic={topic} minutes={tf?.checkpoint.time_limit_minutes ?? 90} problems={problems} drill={drill} />
