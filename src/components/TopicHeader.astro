---
// Top of every lesson: topic, phase, and a "this is my current topic" control.
import { loadData, topicSlug, PHASE_NAMES } from '../lib/data';
import StartTopic from './StartTopic';
import { url } from '../lib/url';

const { topic } = Astro.props as { topic: string };
const data = await loadData();
const t = data.curriculum.find((x) => x.id === topic)!;
---
<div class="topic-header">
  {data.topics[topic]?.draft && (
    <p class="draft-note"><strong>Draft.</strong> This lesson is still being written; sections may be empty or change.</p>
  )}
  <p>
    <strong>Topic {t.id}</strong> · Phase {t.phase} ({PHASE_NAMES[t.phase]}) · target rating {t.target_rating[0]}–{t.target_rating[1]}
  </p>
  <p><a href={url(`/bank/${topicSlug(t.id)}/`)}>All practice problems for this topic</a></p>
  <StartTopic client:load topic={t.id} />
</div>
