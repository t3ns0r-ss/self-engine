---
// Glossary (PLAN.md Section 11.4): alphabetical, with a link to the lesson that introduces each term.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { loadData, lessonHref } from '../lib/data';

const data = await loadData();
const entries = [...data.glossary].sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
const topic = (id: string) => data.curriculum.find((t) => t.id === id)!;
---
<StarlightPage frontmatter={{ title: 'Glossary', description: 'Every term defined in the lessons.' }}>
  {entries.length === 0 ? <p>No terms yet. Each lesson adds the terms it defines.</p> : (
    <dl class="glossary">
      {entries.map((g) => (
        <>
          <dt id={`term-${g.term.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
            {g.term}{g.expansion && <span class="muted"> ({g.expansion})</span>}
          </dt>
          <dd>
            {g.definition}{' '}
            {data.lessons[g.topic]
              ? <a href={lessonHref(topic(g.topic))}>Introduced in {g.topic}</a>
              : <span class="muted">Introduced in {g.topic}</span>}
          </dd>
        </>
      ))}
    </dl>
  )}
</StarlightPage>
