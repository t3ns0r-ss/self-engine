---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ContestsIsland from '../components/ContestsIsland';
---
<StarlightPage frontmatter={{ title: 'Contest log', description: 'Your live contests and upsolve targets.' }}>
  <p>
    Log each live contest. Then list the problems to upsolve: every problem you missed that is rated up to 300 points above
    your current rating. Tick each one off when you have solved it.
  </p>
  <ContestsIsland client:load />
</StarlightPage>
