sequenceDiagram
  participant Test
  Test->>Shop: place_order
  Shop->>Inventory: reserve
  alt out of stock
    Inventory-->>Shop: throws OutOfStock
  else reserved
    Shop->>Payments: charge
    alt declined
      Shop->>Inventory: release
      Shop-->>Test: throws PaymentDeclined
    else paid
      Shop->>Mailer: send
    end
  end
