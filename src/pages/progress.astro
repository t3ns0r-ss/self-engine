---
// Progress page (PLAN.md Section 10.6): export, import, feedback export, reset.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ProgressIsland from '../components/ProgressIsland';
import { loadData, problemIndex } from '../lib/data';

const data = await loadData();
const problems = Object.fromEntries(problemIndex(data).map((p) => [p.id, { title: p.title, topic: p.topic, card: p.cardName }]));
---
<StarlightPage frontmatter={{ title: 'Progress', description: 'Export, import, and reset your progress; send feedback.' }}>
  <p>
    Your progress lives only in this browser. It belongs to this exact address (protocol, domain, and port): if the site moves
    to a new domain, or switches between http and https, it starts empty. <strong>Export before changing the address</strong>,
    then import on the new one. Use the same export and import to move between your phone and laptop.
  </p>
  <ProgressIsland client:load problems={problems} />
</StarlightPage>
