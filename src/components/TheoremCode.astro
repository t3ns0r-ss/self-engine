---
// A theorem's implementation and examples (PLAN.md Section 8.6): the snippet of the unit's solution.cpp,
// then the unit's tested expected output as "Examples".
// Usage in MDX: <TheoremCode unit="1.6/thm-1" />
import { Code } from '@astrojs/starlight/components';
import { snippetOf } from '../lib/snippet';
const { unit } = Astro.props as { unit: string };
const files = import.meta.glob('/code/**/{solution.cpp,tests/1.out}', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const source = files[`/code/${unit}/solution.cpp`];
const output = files[`/code/${unit}/tests/1.out`];
if (source === undefined || output === undefined) throw new Error(`TheoremCode: unit ${unit} not found`);
const snippet = snippetOf(source);
if (snippet === null) throw new Error(`TheoremCode: unit ${unit} has no snippet:begin / snippet:end markers`);
---
<div class="theorem-code">
  <p><strong>Implementation</strong></p>
  <Code code={snippet} lang="cpp" />
  <p><strong>Examples</strong></p>
  <Code code={output.trimEnd()} lang="text" />
</div>
