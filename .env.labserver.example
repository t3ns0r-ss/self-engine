# Copy to .env.labserver (gitignored) and fill in. It is copied to the server by `labserver.sh sync`.
# LABSERVER_HOST=local runs everything on the machine where you run the script (this is the server itself).
LABSERVER_HOST=saurabh@192.168.1.50
LABSERVER_DIR=/home/saurabh/self-engine-mirror
# Bind address for lab service ports. 127.0.0.1 = only processes on the server can connect (default).
# Set to the server's LAN address only for experiments that run a client on another LAN machine.
LAB_BIND=127.0.0.1
LAB_DB_PASSWORD=change-me
# Host ports. Change a port here when the default is already taken on the server.
LAB_POSTGRES_PORT=5432
LAB_MYSQL_PORT=3306
LAB_REDIS_PORT=6379
LAB_KAFKA_PORT=9092
# Pinned at D0 after checking each image's official page (see docs/design/TOOLCHAINS.md): name:version@sha256:digest
POSTGRES_IMAGE=postgres:18.6@sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336
MYSQL_IMAGE=mysql:9.7.2@sha256:c7cb87a9822f499375287930cbff71d6d3b201e346b45108b1115b435ee2df13
REDIS_IMAGE=redis:8.8.3@sha256:eb1aa641bc5380ed14442398e45a5a51aeaaac919fab811e4f134eb77c71dd2d
KAFKA_IMAGE=apache/kafka:4.3.1@sha256:77e3df9054047a88b520d0cc46e16696d3b22022e1d580aeccd2632df6532837
KAFKA_ADVERTISED_HOST=localhost
# Connection strings read by integration tests (go test -tags integration). Quoted because the file is sourced by bash
# (the MySQL form contains parentheses). Keep the ports in step with the ones above.
LAB_POSTGRES_DSN="postgres://lab:change-me@127.0.0.1:5432/lab?sslmode=disable"
LAB_MYSQL_DSN="lab:change-me@tcp(127.0.0.1:3306)/lab"
LAB_REDIS_ADDR=127.0.0.1:6379
LAB_KAFKA_BROKERS=127.0.0.1:9092
