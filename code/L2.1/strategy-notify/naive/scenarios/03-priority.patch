--- a/notifier.hpp
+++ b/notifier.hpp
@@ -2,12 +2,15 @@
 #include <stdexcept>
 #include <string>
 
+enum class Priority { Normal, Urgent };
+
 class Notifier {
 public:
-    std::string send(const std::string& channel, const std::string& to, const std::string& text) const {
-        if (channel == "EMAIL") return "EMAIL to " + to + ": " + text;
-        if (channel == "SMS") return "SMS to " + to + ": " + ("[Acme] " + text).substr(0, 160);
-        if (channel == "PUSH") return "PUSH to " + to + ": " + text.substr(0, 60);
+    std::string send(const std::string& channel, const std::string& to, const std::string& text, Priority priority) const {
+        const std::string body = priority == Priority::Urgent ? "URGENT: " + text : text;
+        if (channel == "EMAIL") return "EMAIL to " + to + ": " + body;
+        if (channel == "SMS") return "SMS to " + to + ": " + ("[Acme] " + body).substr(0, 160);
+        if (channel == "PUSH") return "PUSH to " + to + ": " + body.substr(0, 60);
         throw std::invalid_argument("unknown channel: " + channel);
     }
 };
