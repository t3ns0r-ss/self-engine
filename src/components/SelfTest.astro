---
import { mathText } from '../lib/mathText';
// Self-test questions (PLAN.md Section 6.12): answer before opening.
import { loadData } from '../lib/data';
const { topic } = Astro.props as { topic: string };
const data = await loadData();
const items = data.topics[topic]?.self_test ?? [];
import DesignSelfTest from './design/DesignSelfTest.astro';
import { isDesignId } from '../lib/data';
---
{isDesignId(topic) ? <DesignSelfTest topic={topic} /> : (<>
<ol class="self-test">
  {items.map((s) => (
    <li>
      <p><Fragment set:html={mathText(s.q)} /></p>
      <details><summary>Answer</summary><p><Fragment set:html={mathText(s.a)} /></p></details>
    </li>
  ))}
</ol>
</>)}
