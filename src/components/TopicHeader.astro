---
// Top of every lesson: topic, phase, prerequisites, and a "this is my current topic" control.
import { loadData, lessonHref, topicSlug, getUses, PHASE_NAMES } from '../lib/data';
import StartTopic from './StartTopic';
import { url } from '../lib/url';

const { topic } = Astro.props as { topic: string };
const data = await loadData();
const t = data.curriculum.find((x) => x.id === topic)!;
const tf = data.topics[topic];
// Revision 2 topics list what they use in the data file; older ones fall back to `requires`.
const req = tf?.uses ? getUses(data, topic) : t.requires.map((id) => { const r = data.curriculum.find((x) => x.id === id)!; return { topic: r.id, title: r.title, what: '', href: data.lessons[r.id] ? lessonHref(r) : null }; });
---
<div class="topic-header">
  {data.topics[topic]?.draft && (
    <p class="draft-note"><strong>Draft.</strong> This lesson is still being written; sections may be empty or change.</p>
  )}
  <p>
    <strong>Topic {t.id}</strong> · Phase {t.phase} ({PHASE_NAMES[t.phase]}) · target rating {t.target_rating[0]}–{t.target_rating[1]}
  </p>
  {req.length > 0 && (
    <p>
      Builds on:{' '}
      {req.map((r, i) => (
        <>
          {i > 0 && ', '}
          {r.href ? <a href={r.href}>{r.topic} {r.title}</a> : <span>{r.topic} {r.title} <em>(coming soon)</em></span>}
        </>
      ))}
    </p>
  )}
  <p><a href={url(`/bank/${topicSlug(t.id)}/`)}>All practice problems for this topic</a></p>
  <StartTopic client:load topic={t.id} />
</div>
