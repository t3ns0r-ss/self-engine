---
// Starlight footer plus the profile-sync agent (PROFILE_SYNC_PLAN.md Sections 1 and 11): it starts the scheduler on
// every page and announces synced updates in a polite live region.
import Default from '@astrojs/starlight/components/Footer.astro';
---
<Default {...Astro.props}><slot /></Default>
<div id="sync-live" class="sr-only" aria-live="polite" role="status"></div>
<script>
  import { startScheduler } from '../lib/sync/scheduler';
  import { SYNC_EVENT } from '../lib/sync/store';
  startScheduler(import.meta.env.BASE_URL);
  window.addEventListener(SYNC_EVENT, (e) => {
    const message = (e as CustomEvent<{ message?: string }>).detail?.message;
    const live = document.getElementById('sync-live');
    if (message && live) live.textContent = message;
  });
</script>
