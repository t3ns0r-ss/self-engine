diff --git a/push_channel.hpp b/push_channel.hpp
new file mode 100644
index 0000000..31c6aa0
--- /dev/null
+++ b/push_channel.hpp
@@ -0,0 +1,10 @@
+#pragma once
+#include "channel.hpp"
+
+class PushChannel final : public Channel {
+public:
+    std::string send(const std::string& to, const std::string& text) const override {
+        const std::string& t = text;
+        return "PUSH to " + to + ": " + t.substr(0, 60);
+    }
+};
