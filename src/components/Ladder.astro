---
// Problem ladder (PLAN.md Sections 6.9 and 10.2) plus "More practice" from the bank
// (PROBLEM_BANK_PLAN.md Section 12). Usage in MDX: <Ladder topic="1.3" />
import { loadData, problemsOf, practiceOf } from '../lib/data';
import LadderIsland, { type LadderGroup, type ExtraProblem } from './LadderIsland';

const { topic } = Astro.props as { topic: string };
const data = await loadData();
const t = data.curriculum.find((x) => x.id === topic)!;
const tf = data.topics[topic];
const ladder = problemsOf(data, topic, ['ladder']);
const groups: LadderGroup[] = (tf?.cards ?? []).map((c) => ({
  card: { id: c.id, name: c.name },
  problems: ladder
    .filter((p) => p.card === c.id)
    .sort((a, b) => a.rung! - b.rung!)
    .map((p) => ({ id: p.id, title: p.title, url: p.url, source: p.source, difficulty: p.difficulty, rung: p.rung!, twist: p.twist!, summary: p.summary, hints: p.hints!, editorial_url: p.editorial_url })),
}));
const used = new Set(tf?.problems.map((p) => p.id) ?? []);
const patternName = new Map((data.patterns[topic]?.patterns ?? []).map((p) => [p.id, p.name]));
const more: ExtraProblem[] = practiceOf(data.banks[topic])
  .filter((p) => !used.has(p.id))
  .sort((a, b) => a.tier - b.tier || (a.id < b.id ? -1 : 1))
  .map((p) => ({ id: p.id, title: p.title, url: p.url, source: p.source, difficulty: p.difficulty, tier: p.tier, pattern: patternName.get(p.pattern) ?? p.pattern }));
const budget = t.phase <= 1 ? '20 minutes' : '30–45 minutes';
---
<LadderIsland client:load groups={groups} more={more} budget={budget} />
