---
// Decision map entries added by a design topic (Section 8.14): symptoms (LLD) or needs with numbers (HLD).
import { loadData } from '../../lib/data';
import { url } from '../../lib/url';
const { topic } = Astro.props as { topic: string };
const data = await loadData();
const entries = data.designTopics[topic]?.decision_map ?? [];
const track = topic.startsWith('L') ? 'lld' : 'hld';
const name = (id: string, from?: string) => {
  for (const t of [from, ...Object.keys(data.designTopics)]) {
    const c = t && data.designTopics[t]?.cards.find((x) => x.id === id);
    if (c) return c.name;
  }
  return id;
};
---
<div class="table-scroll">
  <table>
    <thead><tr><th>When you see</th><th>Choose</th><th>If</th><th>Instead of</th></tr></thead>
    <tbody>
      {entries.map((e) => (
        <tr>
          <td>{e.weak_signal}</td>
          <td>{name(e.choose, topic)}</td>
          <td>{e.when}</td>
          <td>{e.over.length ? <ul>{e.over.map((o) => <li><strong>{name(o.card, o.topic)}</strong>: {o.because}</li>)}</ul> : '—'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p><a href={url(`/${track}/handbook/`)}>See the whole {track === 'lld' ? 'Pattern' : 'Component'} Handbook</a></p>
