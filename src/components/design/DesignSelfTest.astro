---
// Self-test questions (Section 8.12): answer before opening.
import { loadData } from '../../lib/data';
const { topic } = Astro.props as { topic: string };
const data = await loadData();
const items = data.designTopics[topic]?.self_test ?? [];
---
<ol class="self-test">
  {items.map((s) => (
    <li><p>{s.q}</p><details><summary>Answer</summary><p>{s.a}</p></details></li>
  ))}
</ol>
