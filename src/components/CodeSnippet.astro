---
// Shows only the gist of a tested code unit: the lines between `// snippet:begin` and `// snippet:end`
// in code/{unit}/solution.cpp (PLAN.md Section 8.6). The rest of the file (includes, main, input) stays out of the lesson.
// Usage in MDX: <CodeSnippet unit="1.6/next-greater" />
import { Code } from '@astrojs/starlight/components';
import { snippetOf } from '../lib/snippet';
const { unit, title } = Astro.props as { unit: string; title?: string };
const files = import.meta.glob('/code/**/solution.cpp', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const source = files[`/code/${unit}/solution.cpp`];
if (source === undefined) throw new Error(`CodeSnippet: unit ${unit} not found`);
const snippet = snippetOf(source);
if (snippet === null) throw new Error(`CodeSnippet: unit ${unit} has no snippet:begin / snippet:end markers`);
---
<Code code={snippet} lang="cpp" title={title} />
