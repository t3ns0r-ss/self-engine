---
// How to start and test an exercise kit (Section 11.2): the new_attempt.sh and test.sh commands, with copy buttons.
import { Code } from '@astrojs/starlight/components';
const { kit, server = false } = Astro.props as { kit: string; server?: boolean };
const start = `bash scripts/new_attempt.sh ${kit}`;
const test = `bash exercises/${kit}/test.sh work/${kit}`;
const lab = `bash scripts/labserver.sh kit ${kit} work/${kit}`;
---
<div class="kit-instructions">
  <p><strong>Start:</strong></p>
  <Code code={start} lang="bash" />
  <p><strong>Test your work:</strong></p>
  <Code code={test} lang="bash" />
  {server && (<><p><strong>On the lab server:</strong></p><Code code={lab} lang="bash" /></>)}
</div>
