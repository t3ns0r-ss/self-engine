---
// Profiles page (PROFILE_SYNC_PLAN.md Section 11): link Codeforces, AtCoder and LeetCode accounts.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ProfilesIsland from '../components/ProfilesIsland';
---
<StarlightPage frontmatter={{ title: 'Profiles', description: 'Link your Codeforces, AtCoder and LeetCode accounts so problem statuses come from your real submissions.' }}>
  <p>
    Enter your handles and the site shows each problem's status from your real submissions. Your own log (minutes, hints,
    mistakes) is never overwritten: synced statuses are worked out when a page loads and are not stored in it.
  </p>
  <p>
    Requests go from your browser straight to the platforms, so they see your IP address, as when you visit them. Handles
    stay in this browser and in your progress export. No password or cookie is ever asked for.
  </p>
  <ProfilesIsland client:load />
</StarlightPage>
