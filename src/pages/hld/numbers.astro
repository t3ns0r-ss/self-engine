---
// Numbers sheet (Section 11.5): constants with sources and caveats, the learner's own measured values, and flashcards.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { parse } from 'yaml';
import constantsText from '../../data/constants.yaml?raw';
import NumberFlashcards from '../../components/design/NumberFlashcards';
import NumbersTable from '../../components/design/NumbersTable';
const constants = (parse(constantsText) ?? []) as { id: string; quantity: string; value: number; unit: string; display: string; source: { title: string; url: string; accessed: string; section: string }; caveat: string }[];
---
<StarlightPage frontmatter={{ title: 'Numbers sheet' }}>
  <p>Order-of-magnitude constants, each with the source that was opened and a caveat. Enter your own measured value once; the labs print the same quantities.</p>
  <NumbersTable client:load constants={constants} />
  <h2>Flashcards</h2>
  <NumberFlashcards client:load constants={constants} />
</StarlightPage>
