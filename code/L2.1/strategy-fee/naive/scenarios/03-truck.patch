 #include <stdexcept>
 #include <string>
 
+enum class Vehicle { Car, Truck };
+
 class FeeCalculator {
 public:
-    long long fee(const std::string& plan, long long minutes) const {
-        if (plan == "HOURLY") return (std::max(minutes - 30, 0LL) + 59) / 60 * 20;
+    long long fee(const std::string& plan, long long minutes, Vehicle vehicle) const {
+        const bool truck = vehicle == Vehicle::Truck;
+        if (plan == "HOURLY") return (std::max(minutes - 30, 0LL) + 59) / 60 * (truck ? 40 : 20);
         if (plan == "WEEKEND") return (minutes + 59) / 60 * 40;
-        if (plan == "DAILY") return (minutes + 1439) / 1440 * 100;
+        if (plan == "DAILY") return (minutes + 1439) / 1440 * (truck ? 150 : 100);
         throw std::invalid_argument("unknown plan: " + plan);
     }
 };
