---
// Every problem across topics (PLAN.md Section 11.4), filterable and sortable, with the learner's status.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ProblemsIsland from '../components/ProblemsIsland';
import { loadData, problemIndex } from '../lib/data';

const data = await loadData();
const order = Object.fromEntries(data.curriculum.map((t) => [t.id, t.order]));
const rows = problemIndex(data).sort((a, b) => order[a.topic] - order[b.topic] || a.id.localeCompare(b.id));
---
<StarlightPage frontmatter={{ title: 'Problems', description: 'Every problem in the programme, with your status.' }}>
  <p>
    Every practice and lesson problem. Checkpoint, review, and exam problems stay hidden until you pass the checkpoint of their
    topic, so you meet them unseen.
  </p>
  <ProblemsIsland client:load rows={rows} order={order} />
</StarlightPage>
