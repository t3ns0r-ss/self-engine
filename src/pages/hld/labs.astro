---
// Index of labs (Section 11.7): topic, what is built, infra, rung count, progress, link to the lesson.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { loadData, designLessonHref } from '../../lib/data';
import { allExercises } from '../../lib/exercises';
import LabProgress from '../../components/design/LabProgress';
const data = await loadData();
const rungs = allExercises().filter((e) => e.role === 'ladder');
const rows = data.designCurriculum.filter((t) => t.track === 'hld' && t.lab && !/^none/.test(t.lab));
const items = rows.map((t) => ({
  id: t.id, title: t.title, lab: t.lab!, infra: t.infra ?? [],
  href: data.lessons[t.id] ? `${designLessonHref(t)}#6-reference-designs` : null,
  rungs: rungs.filter((e) => e.topic === t.id).map((e) => e.globalId),
}));
---
<StarlightPage frontmatter={{ title: 'Labs' }}>
  <p>{items.length} labs. Each is built in Go, tested on the simulated network, run as real processes on the lab server, and measured.</p>
  <LabProgress client:load items={items} />
</StarlightPage>
